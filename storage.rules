rules_version = '2';

// Journal images live at journal/{relationshipId}/{userId}/{file}. Membership is
// read from the matching Firestore relationship document so an image is visible
// to exactly the two people in that relationship.
service firebase.storage {
  match /b/{bucket}/o {
    function isMember(relationshipId) {
      let data = firestore.get(/databases/(default)/documents/relationships/$(relationshipId)).data;
      return request.auth != null
        && (data.doerId == request.auth.uid || data.supporterId == request.auth.uid);
    }

    match /journal/{relationshipId}/{userId}/{fileName} {
      allow read: if isMember(relationshipId);
      allow write: if isMember(relationshipId)
        && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
